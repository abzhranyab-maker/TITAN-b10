<style>
/* ═══════════════════════════════════
   DESIGN SYSTEM
═══════════════════════════════════ */
:root {
  --gold:       #f0c040;
  --gold-dim:   #8a6a10;
  --gold-faint: rgba(240,192,64,0.08);
  --green:      #00e87a;
  --red:        #ff3b5c;
  --blue:       #38b6ff;
  --bg:         #05080f;
  --bg2:        #090e1a;
  --bg3:        #0e1525;
  --card:       rgba(9,14,26,0.95);
  --border:     rgba(240,192,64,0.14);
  --text:       #dde4f5;
  --muted:      #5a6a88;
  --radius:     14px;
}
*{margin:0;padding:0;box-sizing:border-box;}
html{scroll-behavior:smooth;}
body{
  background:var(--bg);
  color:var(--text);
  font-family:'Cairo',sans-serif;
  min-height:100vh;
  overflow-x:hidden;
}

/* ── BACKGROUND ── */
.bg-layer{
  position:fixed;inset:0;z-index:0;pointer-events:none;
}
.bg-grid{
  background-image:
    linear-gradient(rgba(240,192,64,0.035) 1px, transparent 1px),
    linear-gradient(90deg, rgba(240,192,64,0.035) 1px, transparent 1px);
  background-size:52px 52px;
  animation:gridDrift 25s linear infinite;
}
@keyframes gridDrift{to{background-position:52px 52px;}}
.bg-glow{
  background:
    radial-gradient(ellipse 80% 45% at 50% -5%, rgba(240,192,64,0.09) 0%, transparent 65%),
    radial-gradient(ellipse 40% 30% at 90% 90%, rgba(56,182,255,0.05) 0%, transparent 55%);
}
.bg-noise{
  opacity:.025;
  background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='4'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  background-size:180px;
}

/* ═══════════════════════════════════
   AUTH SCREEN
═══════════════════════════════════ */
#authScreen{
  position:fixed;inset:0;z-index:1000;
  display:flex;align-items:center;justify-content:center;
  flex-direction:column;
  background:radial-gradient(ellipse 100% 100% at 50% 0%, #0c1428 0%, #05080f 60%);
}
.auth-emblem{
  position:relative;margin-bottom:2.5rem;
  display:flex;flex-direction:column;align-items:center;
}
.auth-ring{
  width:110px;height:110px;border-radius:50%;
  border:2px solid rgba(240,192,64,0.25);
  display:flex;align-items:center;justify-content:center;
  position:relative;
  animation:ringRotate 8s linear infinite;
}
.auth-ring::before{
  content:'';position:absolute;inset:-8px;border-radius:50%;
  border:1px solid rgba(240,192,64,0.1);
  animation:ringRotate 12s linear infinite reverse;
}
@keyframes ringRotate{to{transform:rotate(360deg);}}
.auth-ring-icon{
  font-size:2.8rem;
  animation:ringRotate 8s linear infinite reverse;
  filter:drop-shadow(0 0 12px rgba(240,192,64,0.5));
}
.auth-wordmark{
  font-family:'Orbitron',monospace;
  font-size:clamp(2.8rem,9vw,5rem);
  font-weight:900;
  color:var(--gold);
  letter-spacing:.18em;
  text-shadow:0 0 40px rgba(240,192,64,.55),0 0 90px rgba(240,192,64,.18);
  margin-top:1.4rem;
  animation:auraPulse 3s ease-in-out infinite;
}
@keyframes auraPulse{
  0%,100%{text-shadow:0 0 40px rgba(240,192,64,.55),0 0 90px rgba(240,192,64,.18);}
  50%{text-shadow:0 0 70px rgba(240,192,64,.85),0 0 140px rgba(240,192,64,.35);}
}
.auth-tagline{
  font-size:.82rem;color:var(--muted);
  letter-spacing:.28em;text-transform:uppercase;margin-top:.5rem;
}

.auth-card{
  background:rgba(9,14,26,.96);
  border:1px solid var(--border);
  border-radius:18px;
  padding:2.6rem 3rem;
  width:min(420px,92vw);
  backdrop-filter:blur(24px);
  box-shadow:0 0 80px rgba(240,192,64,.06),0 40px 80px rgba(0,0,0,.65);
  position:relative;overflow:hidden;
}
.auth-card::before{
  content:'';position:absolute;top:0;left:20%;right:20%;height:1px;
  background:linear-gradient(90deg,transparent,var(--gold),transparent);
}

/* URL field */
.field-group{margin-bottom:1.3rem;}
.field-label{
  font-size:.72rem;color:var(--gold);
  letter-spacing:.18em;text-transform:uppercase;
  margin-bottom:.55rem;display:flex;align-items:center;gap:.4rem;
}
.field-input{
  width:100%;background:rgba(255,255,255,.04);
  border:1px solid rgba(255,255,255,.1);border-radius:9px;
  padding:.85rem 1.1rem;color:var(--text);
  font-family:'Cairo',sans-serif;font-size:.95rem;
  outline:none;transition:all .25s;
}
.field-input:focus{
  border-color:rgba(240,192,64,.45);
  background:rgba(240,192,64,.04);
  box-shadow:0 0 0 3px rgba(240,192,64,.1);
}
.field-input.pass-field{
  direction:ltr;text-align:center;letter-spacing:.18em;font-size:1.05rem;
}

.auth-hint{
  font-size:.72rem;color:var(--muted);
  text-align:center;margin-bottom:1rem;line-height:1.6;
}

.btn-primary{
  width:100%;
  background:linear-gradient(135deg,#9a6808,var(--gold),#c8960a);
  background-size:220%;
  border:none;border-radius:10px;
  padding:.95rem;
  color:#05080f;
  font-family:'Cairo',sans-serif;font-size:1rem;font-weight:900;
  letter-spacing:.08em;cursor:pointer;
  transition:all .3s;position:relative;overflow:hidden;
}
.btn-primary::after{
  content:'';position:absolute;inset:0;
  background:linear-gradient(135deg,transparent,rgba(255,255,255,.15),transparent);
  transform:translateX(-100%);transition:transform .4s;
}
.btn-primary:hover{background-position:right;transform:translateY(-2px);box-shadow:0 10px 32px rgba(240,192,64,.4);}
.btn-primary:hover::after{transform:translateX(100%);}
.btn-primary:active{transform:translateY(0);}
.btn-primary:disabled{opacity:.55;cursor:not-allowed;transform:none;}

.auth-err{
  min-height:1.3em;color:var(--red);
  font-size:.82rem;text-align:center;margin-top:.9rem;
  animation:shake .4s ease;
}
@keyframes shake{0%,100%{transform:translateX(0)}25%{transform:translateX(-8px)}75%{transform:translateX(8px)}}

/* ═══════════════════════════════════
   MAIN APP
═══════════════════════════════════ */
#app{display:none;position:relative;z-index:1;}

/* HEADER */
header{
  position:sticky;top:0;z-index:200;
  background:rgba(5,8,15,.9);backdrop-filter:blur(28px);
  border-bottom:1px solid var(--border);
  height:60px;padding:0 1.8rem;
  display:flex;align-items:center;justify-content:space-between;
}
.hdr-logo{
  font-family:'Orbitron',monospace;font-weight:900;font-size:1.2rem;
  color:var(--gold);letter-spacing:.12em;
  text-shadow:0 0 16px rgba(240,192,64,.4);
}
.hdr-logo small{
  display:block;font-size:.6rem;color:var(--muted);
  font-family:'Cairo',sans-serif;font-weight:400;letter-spacing:.05em;
  margin-top:1px;
}
.hdr-right{display:flex;align-items:center;gap:1rem;}
.source-badge{
  font-size:.68rem;padding:.25rem .7rem;border-radius:20px;font-weight:700;
  letter-spacing:.06em;
}
.source-live{background:rgba(0,232,122,.1);border:1px solid rgba(0,232,122,.3);color:var(--green);}
.source-fb{background:rgba(240,192,64,.1);border:1px solid rgba(240,192,64,.25);color:var(--gold);}
.live-dot{
  width:6px;height:6px;border-radius:50%;
  background:currentColor;display:inline-block;margin-left:.3rem;
  animation:blink 1.4s ease-in-out infinite;
}
@keyframes blink{0%,100%{opacity:1}50%{opacity:.2}}
.hdr-clock{font-family:'Orbitron',monospace;font-size:.78rem;color:var(--muted);letter-spacing:.06em;}

/* MAIN WRAP */
main{max-width:1440px;margin:0 auto;padding:1.8rem;}

/* STAT STRIP */
.stats-strip{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(190px,1fr));
  gap:.9rem;margin-bottom:1.8rem;
}
.scard{
  background:var(--card);border:1px solid var(--border);border-radius:var(--radius);
  padding:1.3rem 1.5rem;position:relative;overflow:hidden;
  backdrop-filter:blur(12px);
  transition:transform .3s,box-shadow .3s;
  opacity:0;transform:translateY(18px);
  animation:popIn .45s forwards;
}
.scard::after{
  content:'';position:absolute;top:0;left:0;right:0;height:2px;
  background:linear-gradient(90deg,transparent,var(--gold),transparent);opacity:.6;
}
.scard:hover{transform:translateY(-5px);box-shadow:0 14px 40px rgba(240,192,64,.1);}
@keyframes popIn{to{opacity:1;transform:translateY(0);}}
.scard:nth-child(1){animation-delay:.08s}
.scard:nth-child(2){animation-delay:.16s}
.scard:nth-child(3){animation-delay:.24s}
.scard:nth-child(4){animation-delay:.32s}
.sc-label{font-size:.7rem;color:var(--muted);letter-spacing:.1em;margin-bottom:.45rem;}
.sc-val{font-size:2rem;font-weight:900;line-height:1;}
.sc-sub{font-size:.72rem;color:var(--muted);margin-top:.25rem;}

/* TICKER */
.ticker-tape{
  height:34px;border-top:1px solid var(--border);border-bottom:1px solid var(--border);
  background:rgba(5,8,15,.97);overflow:hidden;
  display:flex;align-items:center;margin-bottom:1.8rem;
}
.ticker-inner{
  display:flex;white-space:nowrap;
  animation:tickerMove 35s linear infinite;
}
.ticker-inner:hover{animation-play-state:paused;}
@keyframes tickerMove{from{transform:translateX(0)}to{transform:translateX(-50%)}}
.t-item{
  display:inline-flex;align-items:center;gap:.45rem;
  padding:0 1.8rem;
  border-left:1px solid rgba(255,255,255,.05);
  font-size:.74rem;font-family:'Orbitron',monospace;letter-spacing:.04em;color:var(--muted);
}
.t-item .tn{color:var(--text);font-weight:700;}
.t-item .up{color:var(--green);}
.t-item .dn{color:var(--red);}

/* CONTROLS BAR */
.ctrl-bar{
  display:flex;align-items:center;gap:.8rem;
  flex-wrap:wrap;margin-bottom:1.4rem;
}
.btn-fetch{
  display:flex;align-items:center;gap:.55rem;
  background:linear-gradient(135deg,#8a6010,var(--gold));
  border:none;border-radius:9px;padding:.72rem 1.5rem;
  color:#05080f;font-family:'Cairo',sans-serif;
  font-size:.9rem;font-weight:900;cursor:pointer;
  transition:all .3s;white-space:nowrap;
}
.btn-fetch:hover{transform:translateY(-2px);box-shadow:0 8px 24px rgba(240,192,64,.35);}
.btn-fetch:disabled{opacity:.55;cursor:not-allowed;transform:none;}
.spin-icon{display:inline-block;}
.spinning{animation:spin .7s linear infinite;}
@keyframes spin{to{transform:rotate(360deg);}}

.fgroup{display:flex;gap:.4rem;flex-wrap:wrap;}
.fbtn{
  background:rgba(255,255,255,.04);
  border:1px solid rgba(255,255,255,.09);border-radius:7px;
  padding:.55rem 1rem;color:var(--muted);
  font-family:'Cairo',sans-serif;font-size:.82rem;font-weight:600;
  cursor:pointer;transition:all .2s;
}
.fbtn.on,.fbtn:hover{
  background:rgba(240,192,64,.1);
  border-color:rgba(240,192,64,.35);color:var(--gold);
}
.search-inp{
  flex:1;min-width:160px;
  background:rgba(255,255,255,.04);
  border:1px solid rgba(255,255,255,.09);border-radius:7px;
  padding:.58rem 1rem;color:var(--text);
  font-family:'Cairo',sans-serif;font-size:.88rem;outline:none;
  transition:all .2s;
}
.search-inp:focus{border-color:rgba(240,192,64,.38);background:rgba(240,192,64,.03);}

/* TABLE PANEL */
.tpanel{
  background:var(--card);border:1px solid var(--border);
  border-radius:var(--radius);overflow:hidden;
  backdrop-filter:blur(14px);
  box-shadow:0 0 80px rgba(0,0,0,.45);
  position:relative;
}
.tpanel-hdr{
  display:flex;align-items:center;justify-content:space-between;
  padding:1.1rem 1.6rem;border-bottom:1px solid var(--border);
}
.tpanel-title{
  font-size:.85rem;font-weight:700;color:var(--gold);
  letter-spacing:.05em;display:flex;align-items:center;gap:.5rem;
}
.tpanel-count{font-size:.72rem;color:var(--muted);}
.tscroll{overflow-x:auto;}
table{width:100%;border-collapse:collapse;}
thead th{
  background:rgba(240,192,64,.055);
  padding:.9rem 1.3rem;text-align:right;
  font-size:.72rem;font-weight:700;color:var(--gold);
  letter-spacing:.08em;text-transform:uppercase;
  white-space:nowrap;cursor:pointer;user-select:none;
  border-bottom:1px solid var(--border);transition:background .2s;
}
thead th:hover{background:rgba(240,192,64,.09);}
tbody tr{
  border-bottom:1px solid rgba(255,255,255,.04);
  transition:background .18s;cursor:pointer;
}
tbody tr:last-child{border-bottom:none;}
tbody tr:hover{background:rgba(240,192,64,.035);}
td{padding:.95rem 1.3rem;font-size:.88rem;white-space:nowrap;}

.stock-code{
  font-family:'Orbitron',monospace;font-size:.82rem;
  font-weight:700;color:var(--text);letter-spacing:.05em;
}
.stock-nm{font-size:.68rem;color:var(--muted);margin-top:.1rem;}
.price-cell{
  font-family:'Orbitron',monospace;font-weight:700;font-size:.88rem;
}
.chg-pos{color:var(--green);}
.chg-neg{color:var(--red);}
.chg-neu{color:var(--muted);}

.badge{
  display:inline-flex;align-items:center;gap:.28rem;
  padding:.28rem .75rem;border-radius:20px;
  font-size:.76rem;font-weight:700;letter-spacing:.04em;
}
.g-ap{background:rgba(0,232,122,.1);color:var(--green);border:1px solid rgba(0,232,122,.28);}
.g-a {background:rgba(56,182,255,.09);color:var(--blue);border:1px solid rgba(56,182,255,.22);}
.g-b {background:rgba(240,192,64,.09);color:var(--gold);border:1px solid rgba(240,192,64,.22);}
.g-c {background:rgba(255,59,92,.09);color:var(--red);border:1px solid rgba(255,59,92,.22);}

.sbar-wrap{display:flex;align-items:center;gap:.6rem;}
.sbar{flex:1;min-width:72px;height:4px;background:rgba(255,255,255,.06);border-radius:2px;overflow:hidden;}
.sbar-fill{height:100%;border-radius:2px;background:linear-gradient(90deg,var(--gold-dim),var(--gold));transition:width 1.1s cubic-bezier(.34,1.56,.64,1);}
.snum{font-weight:700;font-size:.8rem;color:var(--gold);min-width:26px;font-family:'Orbitron',monospace;}

.vol-wrap{display:flex;align-items:center;gap:.4rem;font-size:.82rem;font-weight:600;}
.vbar{width:36px;height:3px;background:rgba(255,255,255,.06);border-radius:2px;overflow:hidden;}
.vbar-fill{height:100%;border-radius:2px;}

/* LOADING OVERLAY */
.lov{
  display:none;position:absolute;inset:0;z-index:20;
  background:rgba(5,8,15,.75);backdrop-filter:blur(6px);
  align-items:center;justify-content:center;
  flex-direction:column;gap:1.4rem;border-radius:var(--radius);
}
.lov.on{display:flex;}
.lspinner{
  width:52px;height:52px;
  border:3px solid rgba(240,192,64,.12);
  border-top-color:var(--gold);border-radius:50%;
  animation:spin .75s linear infinite;
}
.lmsg{color:var(--gold);font-size:.82rem;letter-spacing:.15em;animation:loadPulse 1.5s ease-in-out infinite;}
@keyframes loadPulse{0%,100%{opacity:1}50%{opacity:.35}}

/* MODAL */
.mbg{
  display:none;position:fixed;inset:0;z-index:600;
  background:rgba(0,0,0,.78);backdrop-filter:blur(10px);
  align-items:center;justify-content:center;padding:1rem;
}
.mbg.on{display:flex;}
.modal{
  background:var(--bg2);border:1px solid var(--border);
  border-radius:20px;width:min(700px,100%);
  max-height:88vh;overflow-y:auto;
  box-shadow:0 0 120px rgba(240,192,64,.1),0 50px 100px rgba(0,0,0,.85);
  animation:mIn .38s cubic-bezier(.34,1.56,.64,1);
}
@keyframes mIn{from{opacity:0;transform:scale(.9) translateY(24px);}}
.mhdr{
  padding:1.7rem 1.9rem 1.2rem;
  border-bottom:1px solid var(--border);
  display:flex;align-items:center;justify-content:space-between;
}
.mtitle{font-family:'Orbitron',monospace;font-size:1.35rem;font-weight:900;color:var(--gold);}
.msub{font-size:.75rem;color:var(--muted);margin-top:.2rem;}
.mclose{
  width:34px;height:34px;border-radius:7px;
  background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.09);
  color:var(--muted);font-size:1.1rem;cursor:pointer;
  display:flex;align-items:center;justify-content:center;
  transition:all .2s;
}
.mclose:hover{background:rgba(255,59,92,.15);border-color:rgba(255,59,92,.3);color:var(--red);}
.mbody{padding:1.7rem 1.9rem;}
.mgrid{display:grid;grid-template-columns:1fr 1fr;gap:.9rem;margin-bottom:1.4rem;}
.mstat{
  background:rgba(255,255,255,.03);
  border:1px solid rgba(255,255,255,.07);
  border-radius:11px;padding:1rem 1.2rem;
}
.ms-lbl{font-size:.68rem;color:var(--muted);letter-spacing:.1em;text-transform:uppercase;margin-bottom:.35rem;}
.ms-val{font-size:1.25rem;font-weight:700;font-family:'Orbitron',monospace;}
.clist{display:flex;flex-direction:column;gap:.6rem;}
.citem{
  display:flex;align-items:center;gap:.85rem;
  background:rgba(255,255,255,.025);
  border-radius:9px;padding:.75rem 1rem;font-size:.85rem;
}
.citem.ok{border-right:3px solid var(--green);}
.citem.fail{border-right:3px solid rgba(255,255,255,.06);}
.cicon{font-size:1rem;flex-shrink:0;}
.ctxt{flex:1;line-height:1.4;}
.ctxt small{font-size:.72rem;color:var(--muted);display:block;margin-top:.1rem;}
.citem.fail .ctxt{color:var(--muted);}
.cpts{font-weight:800;font-size:.82rem;color:var(--gold);font-family:'Orbitron',monospace;}
.mdiscl{
  margin-top:1.4rem;padding:.9rem 1.1rem;
  background:rgba(240,192,64,.05);border:1px solid rgba(240,192,64,.12);
  border-radius:9px;font-size:.75rem;color:var(--muted);line-height:1.7;
}
/* mini chart in modal */
.mini-chart{
  margin-bottom:1.4rem;
  background:rgba(255,255,255,.025);border:1px solid rgba(255,255,255,.06);
  border-radius:11px;padding:1rem 1.2rem;
}
.mc-title{font-size:.7rem;color:var(--gold);letter-spacing:.1em;text-transform:uppercase;margin-bottom:.8rem;}
.mc-bars{display:flex;align-items:flex-end;gap:3px;height:52px;}
.mc-bar{
  flex:1;border-radius:2px 2px 0 0;
  background:rgba(240,192,64,.25);
  transition:height .6s cubic-bezier(.34,1.56,.64,1);
}
.mc-bar.active{background:var(--gold);}

/* EMPTY STATE */
.empty{text-align:center;padding:5rem 2rem;color:var(--muted);}
.empty-ico{font-size:3.5rem;margin-bottom:1rem;opacity:.35;}
.empty-ttl{font-size:1rem;font-weight:700;color:var(--text);margin-bottom:.4rem;}
.empty-sub{font-size:.8rem;}

/* TOAST */
.toast{
  position:fixed;bottom:2rem;left:50%;transform:translateX(-50%);
  border-radius:9px;padding:.75rem 1.5rem;
  font-size:.85rem;font-weight:600;z-index:900;
  display:none;animation:tIn .3s ease;white-space:nowrap;
}
@keyframes tIn{from{opacity:0;transform:translateX(-50%) translateY(8px);}}
.toast.ok{background:rgba(0,232,122,.12);border:1px solid rgba(0,232,122,.32);color:var(--green);}
.toast.er{background:rgba(255,59,92,.12);border:1px solid rgba(255,59,92,.3);color:var(--red);}
.toast.wr{background:rgba(240,192,64,.12);border:1px solid rgba(240,192,64,.25);color:var(--gold);}

/* CONNECTION BANNER */
.conn-banner{
  display:none;
  margin-bottom:1rem;padding:.8rem 1.3rem;
  background:rgba(240,192,64,.08);border:1px solid rgba(240,192,64,.22);
  border-radius:10px;font-size:.82rem;color:var(--gold);
  align-items:center;gap:.7rem;line-height:1.6;
}
.conn-banner.show{display:flex;}
.conn-banner code{
  background:rgba(240,192,64,.15);border-radius:4px;
  padding:.1rem .45rem;font-size:.78rem;letter-spacing:.04em;
  font-family:'Orbitron',monospace;
}

/* FOOTER */
footer{
  margin-top:2.5rem;padding:1.3rem 1.8rem;
  border-top:1px solid var(--border);
  display:flex;align-items:center;justify-content:space-between;
  flex-wrap:wrap;gap:.8rem;
}
.ft-brand{font-family:'Orbitron',monospace;font-size:.7rem;color:var(--gold-dim);letter-spacing:.14em;}
.ft-note{font-size:.68rem;color:var(--muted);}

/* ── AI CHAT INSIDE MODAL ── */
.ai-chat-section{
  margin-top:1.4rem;
  border:1px solid rgba(240,192,64,0.18);
  border-radius:12px;
  overflow:hidden;
  background:rgba(5,8,15,0.6);
}
.ai-chat-header{
  display:flex;align-items:center;gap:0.6rem;
  padding:0.75rem 1rem;
  background:rgba(240,192,64,0.07);
  border-bottom:1px solid rgba(240,192,64,0.12);
  font-size:0.75rem;font-weight:700;color:var(--gold);
  letter-spacing:0.08em;
}
.ai-chat-dot{
  width:6px;height:6px;border-radius:50%;
  background:var(--green);
  animation:blink 1.5s ease-in-out infinite;
  box-shadow:0 0 5px var(--green);
}
.ai-chat-messages{
  max-height:220px;overflow-y:auto;
  padding:0.8rem 1rem;
  display:flex;flex-direction:column;gap:0.65rem;
  scroll-behavior:smooth;
}
.ai-chat-messages::-webkit-scrollbar{width:3px;}
.ai-chat-messages::-webkit-scrollbar-thumb{background:rgba(240,192,64,0.2);border-radius:2px;}
.acm{display:flex;gap:0.55rem;animation:msgIn 0.28s ease;}
@keyframes msgIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
.acm.user{flex-direction:row-reverse;}
.acm-av{
  width:26px;height:26px;border-radius:7px;flex-shrink:0;
  display:flex;align-items:center;justify-content:center;
  font-size:0.62rem;font-weight:900;
}
.acm.ai .acm-av{
  background:linear-gradient(135deg,#8a6010,var(--gold));
  color:#05080f;font-family:'Orbitron',monospace;
}
.acm.user .acm-av{
  background:rgba(56,182,255,0.15);
  border:1px solid rgba(56,182,255,0.25);
  color:var(--blue);font-size:0.85rem;
}
.acm-bbl{
  max-width:calc(100% - 60px);
  padding:0.6rem 0.85rem;border-radius:10px;
  font-size:0.8rem;line-height:1.65;
}
.acm.ai .acm-bbl{
  background:rgba(13,19,34,0.95);
  border:1px solid rgba(240,192,64,0.1);
  border-top-right-radius:3px;color:var(--text);
}
.acm.user .acm-bbl{
  background:rgba(240,192,64,0.1);
  border:1px solid rgba(240,192,64,0.2);
  border-top-left-radius:3px;color:var(--text);
}
.acm-bbl strong{color:var(--gold);}
.acm-bbl .tg{color:var(--green);font-weight:700;}
.acm-bbl .tr{color:var(--red);font-weight:700;}
.ai-typing{display:flex;gap:4px;align-items:center;padding:0.5rem 0.85rem;
  background:rgba(13,19,34,0.9);border:1px solid rgba(240,192,64,0.1);
  border-radius:10px;border-top-right-radius:3px;width:fit-content;}
.ai-typing span{width:6px;height:6px;border-radius:50%;background:var(--gold);opacity:0.3;
  animation:tdot 1.2s ease-in-out infinite;}
.ai-typing span:nth-child(2){animation-delay:0.18s;}
.ai-typing span:nth-child(3){animation-delay:0.36s;}
@keyframes tdot{0%,60%,100%{opacity:0.3;transform:translateY(0)}30%{opacity:1;transform:translateY(-4px)}}
.ai-chat-input-row{
  display:flex;align-items:center;gap:0.5rem;
  padding:0.65rem 0.85rem;
  border-top:1px solid rgba(240,192,64,0.1);
}
.ai-chat-inp{
  flex:1;background:rgba(255,255,255,0.04);
  border:1px solid rgba(255,255,255,0.08);border-radius:8px;
  padding:0.55rem 0.85rem;color:var(--text);
  font-family:'Cairo',sans-serif;font-size:0.82rem;
  outline:none;transition:all 0.2s;
}
.ai-chat-inp:focus{border-color:rgba(240,192,64,0.38);background:rgba(240,192,64,0.03);}
.ai-chat-inp::placeholder{color:var(--muted);}
.ai-send{
  width:34px;height:34px;border-radius:8px;flex-shrink:0;
  background:linear-gradient(135deg,#8a6010,var(--gold));
  border:none;cursor:pointer;
  display:flex;align-items:center;justify-content:center;
  transition:all 0.2s;
}
.ai-send:hover{transform:translateY(-1px);box-shadow:0 4px 14px rgba(240,192,64,0.35);}
.ai-send:disabled{opacity:0.45;cursor:not-allowed;transform:none;}
.ai-send svg{width:15px;height:15px;fill:#05080f;}
.ai-suggestions-row{
  display:flex;gap:0.45rem;flex-wrap:wrap;
  padding:0.6rem 0.85rem 0;
}
.ai-sug{
  background:rgba(240,192,64,0.07);
  border:1px solid rgba(240,192,64,0.18);
  border-radius:20px;padding:0.28rem 0.75rem;
  font-size:0.72rem;color:var(--gold);font-family:'Cairo',sans-serif;
  cursor:pointer;transition:all 0.18s;white-space:nowrap;
}
.ai-sug:hover{background:rgba(240,192,64,0.15);border-color:rgba(240,192,64,0.4);}

/* RESPONSIVE */
@media(max-width:720px){
  main{padding:1rem;}
  .ctrl-bar{flex-direction:column;align-items:stretch;}
  .fgroup{flex-wrap:wrap;}
  .mgrid{grid-template-columns:1fr;}
  header{padding:0 1rem;}
  td,th{padding:.75rem .8rem;}
}
</style>
</head>
<body>

<!-- BG LAYERS -->
<div class="bg-layer bg-grid"></div>
<div class="bg-layer bg-glow"></div>
<div class="bg-layer bg-noise"></div>

<!-- ══════════════════ AUTH ══════════════════ -->
<div id="authScreen">
  <div class="auth-emblem">
    <div class="auth-ring"><div class="auth-ring-icon">⬡</div></div>
    <div class="auth-wordmark">TITAN</div>
    <div class="auth-tagline">Saudi Market Intelligence — V10</div>
  </div>

  <div class="auth-card">
    <input type="hidden" id="apiUrl" value="http://localhost:5000">
    <div class="field-group">
      <div class="field-label">🔐 كلمة المرور</div>
      <input class="field-input pass-field" id="passInput"
             type="password" placeholder="••••••••" autocomplete="off">
    </div>
    <button class="btn-primary" id="authBtn" onclick="doAuth()">🚀 دخول النظام</button>
    <div class="auth-err" id="authErr"></div>
  </div>
</div>

<!-- ══════════════════ APP ══════════════════ -->
<div id="app">
  <header>
    <div class="hdr-logo">TITAN<small>Saudi Market Intelligence V10</small></div>
    <div class="hdr-right">
      <div id="sourceBadge" class="source-badge source-fb">⏳ جاري الاتصال</div>
      <div class="hdr-clock" id="hdrClock">--:--:--</div>
    </div>
  </header>

  <main>
    <!-- Connection banner -->
    <div class="conn-banner" id="connBanner">
      ⚠️ لم يتم الاتصال بالـ Backend. يتم عرض بيانات تجريبية.
      تأكد أن الخادم يعمل على <code id="bannerUrl">--</code>
    </div>

    <!-- Stats -->
    <div class="stats-strip">
      <div class="scard">
        <div class="sc-label">إجمالي الأسهم</div>
        <div class="sc-val" id="stTotal" style="color:var(--gold)">--</div>
        <div class="sc-sub">سهم في القائمة</div>
      </div>
      <div class="scard">
        <div class="sc-label">تصنيف A+ و A</div>
        <div class="sc-val" id="stTop" style="color:var(--green)">--</div>
        <div class="sc-sub">فرصة جيدة</div>
      </div>
      <div class="scard">
        <div class="sc-label">أعلى نقاط</div>
        <div class="sc-val" id="stBest">--</div>
        <div class="sc-sub" id="stBestName">--</div>
      </div>
      <div class="scard">
        <div class="sc-label">آخر تحديث</div>
        <div class="sc-val" id="stTime" style="font-size:1.15rem">--:--</div>
        <div class="sc-sub" id="stSrc">--</div>
      </div>
    </div>

    <!-- Ticker -->
    <div class="ticker-tape" id="tickerTape" style="display:none">
      <div class="ticker-inner" id="tickerInner"></div>
    </div>

    <!-- Controls -->
    <div class="ctrl-bar">
      <button class="btn-fetch" id="fetchBtn" onclick="fetchData(true)">
        <span class="spin-icon" id="fetchIcon">⟳</span> تحديث البيانات
      </button>
      <div class="fgroup">
        <button class="fbtn on" onclick="setFilter('all',this)">الكل</button>
        <button class="fbtn" onclick="setFilter('A+',this)">🟢 A+</button>
        <button class="fbtn" onclick="setFilter('A',this)">✅ A</button>
        <button class="fbtn" onclick="setFilter('B',this)">🟡 B</button>
        <button class="fbtn" onclick="setFilter('C',this)">🔴 C</button>
      </div>
      <input class="search-inp" id="searchInp" placeholder="🔍 بحث..." oninput="render()">
    </div>

    <!-- Table -->
    <div class="tpanel">
      <div class="tpanel-hdr">
        <div class="tpanel-title">📊 تصنيف الأسهم السعودية</div>
        <div class="tpanel-count" id="tCount"></div>
      </div>
      <div class="tscroll">
        <table>
          <thead>
            <tr>
              <th onclick="sortBy('code')">الرمز ⇅</th>
              <th onclick="sortBy('close')">السعر ⇅</th>
              <th onclick="sortBy('chg')">التغيير% ⇅</th>
              <th onclick="sortBy('score')">النقاط ⇅</th>
              <th>التصنيف</th>
              <th onclick="sortBy('ext_pct')">الامتداد% ⇅</th>
              <th>الحجم النسبي</th>
              <th>ATR%</th>
              <th>الاتجاه</th>
            </tr>
          </thead>
          <tbody id="tBody">
            <tr><td colspan="9"><div class="empty">
              <div class="empty-ico">📡</div>
              <div class="empty-ttl">انتظار الاتصال بالخادم</div>
              <div class="empty-sub">اضغط "تحديث البيانات" لجلب أحدث تحليل</div>
            </div></td></tr>
          </tbody>
        </table>
      </div>
      <div class="lov" id="lov">
        <div class="lspinner"></div>
        <div class="lmsg" id="lovMsg">جاري الاتصال...</div>
      </div>
    </div>

    <footer>
      <div class="ft-brand">TITAN V10 © 2026</div>
      <div class="ft-note">⚠️ للأغراض التعليمية فقط — ليس توصية استثمارية</div>
    </footer>
  </main>
</div>

<!-- MODAL -->
<div class="mbg" id="mbg" onclick="closeMod(event)">
  <div class="modal">
    <div class="mhdr">
      <div>
        <div class="mtitle" id="mTitle">--</div>
        <div class="msub" id="mSub">--</div>
      </div>
      <div class="mclose" onclick="document.getElementById('mbg').classList.remove('on')">✕</div>
    </div>
    <div class="mbody" id="mBody"></div>
  </div>
</div>

<!-- TOAST -->
<div class="toast" id="toast"></div>

<script>
// ══════════════════════════════════════════════
//  GLOBALS
// ══════════════════════════════════════════════
let API_URL  = "http://localhost:5000";
let API_KEY  = "TITAN2026";
let allData  = [];
let activeF  = "all";
let sortKey  = "score";
let sortAsc  = false;
let autoRef  = null;

const NAMES = {
  "1120":"Al Rajhi Bank","1010":"Riyad Bank","1150":"Alinma Bank","1050":"Banque Saudi Fransi",
  "2222":"Saudi Aramco","2010":"SABIC","2020":"Saudi Arabia Fertilizers","2060":"Petro Rabigh",
  "7010":"STC","7020":"Mobily","8010":"Saudi Fransi Capital","8020":"Emaar The Economic City",
  "8030":"Dar Al Arkan","8040":"Kingdom Holding"
};
const SECTORS = {
  "1120":"البنوك","1010":"البنوك","1150":"البنوك","1050":"البنوك",
  "2222":"الطاقة","2010":"البتروكيماويات","2020":"البتروكيماويات","2060":"البتروكيماويات",
  "7010":"الاتصالات","7020":"الاتصالات",
  "8010":"المال","8020":"العقار","8030":"العقار","8040":"الاستثمار"
};

// ══════════════════════════════════════════════
//  AUTH
// ══════════════════════════════════════════════
document.getElementById("passInput").addEventListener("keydown", e => { if(e.key==="Enter") doAuth(); });
document.getElementById("apiUrl").addEventListener("keydown",   e => { if(e.key==="Enter") doAuth(); });

async function doAuth() {
  const url  = document.getElementById("apiUrl").value.trim().replace(/\/+$/, "") || "http://localhost:5000";
  const pass = document.getElementById("passInput").value.trim();
  const btn  = document.getElementById("authBtn");
  const err  = document.getElementById("authErr");
  err.textContent = "";

  // التحقق من كلمة المرور محلياً فوراً
  if (pass !== "TITAN2026") {
    err.textContent = "❌ كلمة المرور غير صحيحة";
    document.getElementById("passInput").value = "";
    return;
  }

  btn.disabled = true;
  btn.textContent = "⏳ جاري الدخول...";
  API_URL = url;
  API_KEY = pass;

  // محاولة Backend اختيارية (3 ثوان فقط)
  try {
    const res = await fetch(`${url}/api/health`, { signal: AbortSignal.timeout(3000) });
    if (res.ok) {
      btn.disabled = false; btn.textContent = "🚀 دخول النظام";
      enterApp(false); return;
    }
  } catch (_) {}

  btn.disabled = false;
  btn.textContent = "🚀 دخول النظام";
  enterApp(true);
}

function enterApp(demo = false) {
  document.getElementById("authScreen").style.cssText = "opacity:0;transition:opacity .5s";
  setTimeout(() => {
    document.getElementById("authScreen").style.display = "none";
    document.getElementById("app").style.display = "block";
    startClock();
    if (demo) {
      loadFallback();
      // تحديث تلقائي كل دقيقتين حتى في Demo
      autoRef = setInterval(() => loadFallback(), 120000);
    } else {
      fetchData(false);
      autoRef = setInterval(() => fetchData(false), 120000);
    }
  }, 500);
}

// ══════════════════════════════════════════════
//  CLOCK
// ══════════════════════════════════════════════
function startClock() {
  function tick() {
    document.getElementById("hdrClock").textContent =
      new Date().toLocaleTimeString("ar-SA", { hour:"2-digit", minute:"2-digit", second:"2-digit", hour12:false });
  }
  tick(); setInterval(tick, 1000);
}

// ══════════════════════════════════════════════
//  FETCH FROM BACKEND
// ══════════════════════════════════════════════
async function fetchData(force = true) {
  const btn  = document.getElementById("fetchBtn");
  const icon = document.getElementById("fetchIcon");
  const lov  = document.getElementById("lov");
  btn.disabled = true;
  icon.classList.add("spinning");
  lov.classList.add("on");

  const msgs = [
    "جاري الاتصال بالخادم...",
    "جاري جلب بيانات TradingView...",
    "جاري تحليل المؤشرات...",
    "جاري احتساب النقاط..."
  ];
  let mi = 0;
  document.getElementById("lovMsg").textContent = msgs[0];
  const mi_int = setInterval(() => {
    document.getElementById("lovMsg").textContent = msgs[Math.min(++mi, msgs.length-1)];
  }, 900);

  try {
    const res = await fetch(`${API_URL}/api/analyze?force=${force}`, {
      headers: { "X-Titan-Key": API_KEY },
      signal: AbortSignal.timeout(30000)
    });
    if (!res.ok) throw new Error(`HTTP ${res.status}`);
    const data = await res.json();

    clearInterval(mi_int);
    lov.classList.remove("on");
    btn.disabled = false;
    icon.classList.remove("spinning");

    allData = data.stocks || [];
    updateStats(data);
    buildTicker();
    render();
    updateSourceBadge(data.source);
    document.getElementById("connBanner").classList.remove("show");
    showToast("✅ تم تحديث البيانات — المصدر: " + (data.source === "live" ? "TradingView ✦" : "Fallback"), "ok");

  } catch(e) {
    clearInterval(mi_int);
    lov.classList.remove("on");
    btn.disabled = false;
    icon.classList.remove("spinning");
    showToast("❌ تعذّر الاتصال بالخادم — يتم عرض بيانات تجريبية", "er");
    document.getElementById("connBanner").classList.add("show");
    document.getElementById("bannerUrl").textContent = API_URL;
    loadFallback();
  }
}

// ══════════════════════════════════════════════
//  FALLBACK (client-side simulation)
// ══════════════════════════════════════════════
const FB = {
  "1120":{close:92.5,sma20:89.2,sma50:85.1,atr:2.1,kelt:94.8,rel_vol:1.8,mcap:180e9,chg:1.2,h1m:96,l1m:84},
  "1010":{close:27.3,sma20:26.8,sma50:25.2,atr:0.7,kelt:28.1,rel_vol:1.2,mcap:65e9,chg:-0.3,h1m:28.5,l1m:24.8},
  "1150":{close:18.9,sma20:19.5,sma50:18.1,atr:0.5,kelt:20.2,rel_vol:2.3,mcap:42e9,chg:2.1,h1m:20.5,l1m:17.5},
  "1050":{close:37.6,sma20:36.1,sma50:34.8,atr:1.0,kelt:38.9,rel_vol:1.6,mcap:88e9,chg:0.8,h1m:39.5,l1m:33.2},
  "2222":{close:27.15,sma20:27.8,sma50:28.5,atr:0.6,kelt:29.0,rel_vol:0.9,mcap:7200e9,chg:-0.5,h1m:29.5,l1m:26},
  "2010":{close:83.2,sma20:80.5,sma50:77.9,atr:2.4,kelt:86.1,rel_vol:2.8,mcap:450e9,chg:3.2,h1m:88,l1m:75},
  "2020":{close:102.0,sma20:98.5,sma50:94.2,atr:3.1,kelt:105.2,rel_vol:1.4,mcap:92e9,chg:1.5,h1m:108,l1m:91},
  "2060":{close:14.8,sma20:15.3,sma50:14.1,atr:0.4,kelt:15.9,rel_vol:3.1,mcap:20e9,chg:4.0,h1m:16.5,l1m:13.2},
  "7010":{close:52.4,sma20:51.2,sma50:49.8,atr:1.5,kelt:53.8,rel_vol:1.7,mcap:165e9,chg:0.9,h1m:55,l1m:48},
  "7020":{close:12.6,sma20:12.1,sma50:11.5,atr:0.38,kelt:12.9,rel_vol:2.2,mcap:25e9,chg:1.6,h1m:13.5,l1m:11},
  "8010":{close:22.8,sma20:22.1,sma50:21.4,atr:0.65,kelt:23.5,rel_vol:1.1,mcap:38e9,chg:0.4,h1m:24,l1m:20.5},
  "8020":{close:8.45,sma20:8.2,sma50:7.9,atr:0.25,kelt:8.7,rel_vol:1.9,mcap:15e9,chg:2.4,h1m:9,l1m:7.5},
  "8030":{close:5.12,sma20:5.4,sma50:5.1,atr:0.18,kelt:5.65,rel_vol:0.8,mcap:8e9,chg:-1.2,h1m:5.8,l1m:4.8},
  "8040":{close:9.2,sma20:9.0,sma50:8.6,atr:0.28,kelt:9.55,rel_vol:1.35,mcap:31e9,chg:0.7,h1m:9.8,l1m:8.4},
};

function scoreLocal(code, b) {
  const noise  = 1 + (Math.random()-0.5)*0.015;
  const close  = parseFloat((b.close * noise).toFixed(2));
  const g1     = close > b.sma20 && b.sma20 > b.sma50 && ((close-b.sma20)/b.sma20*100) <= 20;
  const vol_z  = (b.rel_vol-1)*2.5;
  const g3     = b.mcap >= 50e6 && b.rel_vol >= 1.5 && vol_z >= 2;
  const ext    = parseFloat(((close-b.kelt)/b.kelt*100).toFixed(2));
  const s      = (g1?15:5)+(g3?25:10)+(ext<5?10:0);
  const grade  = s>=45?"A+":s>=35?"A":s>=25?"B":"C";
  const trend  = close>b.sma20&&b.sma20>b.sma50?"up":close<b.sma50?"down":"neutral";
  return {
    code, close, name:NAMES[code]||code, sector:SECTORS[code]||"—",
    sma20:b.sma20, sma50:b.sma50, atr:b.atr, kelt:b.kelt,
    rel_vol:b.rel_vol, mcap:b.mcap, chg:b.chg, h1m:b.h1m, l1m:b.l1m,
    atr_pct:parseFloat((b.atr/close*100).toFixed(2)),
    vol_z:parseFloat(vol_z.toFixed(2)), ext_pct:ext,
    g1, g3, pts_g1:g1?15:5, pts_g3:g3?25:10, pts_kelt:ext<5?10:0,
    score:s, grade, trend, source:"fallback"
  };
}

function loadFallback() {
  allData = Object.entries(FB)
    .map(([c,b]) => scoreLocal(c,b))
    .sort((a,b)=>b.score-a.score);
  updateStats({ total:allData.length, top:allData.filter(d=>["A+","A"].includes(d.grade)).length,
    best_code:allData[0]?.code, best_score:allData[0]?.score, source:"fallback" });
  buildTicker(); render();
  updateSourceBadge("fallback");
}

// ══════════════════════════════════════════════
//  SOURCE BADGE
// ══════════════════════════════════════════════
function updateSourceBadge(src) {
  const el = document.getElementById("sourceBadge");
  if (src === "live") {
    el.className = "source-badge source-live";
    el.innerHTML = '<span class="live-dot"></span> TradingView LIVE';
  } else {
    el.className = "source-badge source-fb";
    el.innerHTML = "⚠️ وضع تجريبي";
  }
  const t = new Date();
  document.getElementById("stTime").textContent =
    t.toLocaleTimeString("ar-SA",{hour:"2-digit",minute:"2-digit",hour12:false});
  document.getElementById("stSrc").textContent =
    src === "live" ? "بيانات مباشرة من TradingView" : "بيانات تجريبية";
}

// ══════════════════════════════════════════════
//  STATS
// ══════════════════════════════════════════════
function updateStats(d) {
  document.getElementById("stTotal").textContent = d.total || allData.length;
  document.getElementById("stTop").textContent = d.top ?? allData.filter(x=>["A+","A"].includes(x.grade)).length;
  document.getElementById("stBest").textContent = d.best_score ?? (allData[0]?.score || "--");
  document.getElementById("stBestName").textContent = d.best_code ? (d.best_code + " — " + (NAMES[d.best_code]||"")) : "--";
}

// ══════════════════════════════════════════════
//  TICKER
// ══════════════════════════════════════════════
function buildTicker() {
  if (!allData.length) return;
  const tape = document.getElementById("tickerTape");
  const inner = document.getElementById("tickerInner");
  const items = [...allData,...allData].map(d=>{
    const cls = d.chg > 0 ? "up" : d.chg < 0 ? "dn" : "";
    const sign = d.chg >= 0 ? "+" : "";
    return `<div class="t-item"><span class="tn">${d.code}</span>${d.close.toFixed(2)} <span class="${cls}">${sign}${(d.chg||0).toFixed(2)}%</span></div>`;
  }).join("");
  inner.innerHTML = items;
  tape.style.display = "flex";
}

// ══════════════════════════════════════════════
//  FILTER & SORT
// ══════════════════════════════════════════════
function setFilter(f, btn) {
  activeF = f;
  document.querySelectorAll(".fbtn").forEach(b => b.classList.remove("on"));
  btn.classList.add("on");
  render();
}

function sortBy(k) {
  if (sortKey === k) sortAsc = !sortAsc; else { sortKey = k; sortAsc = false; }
  render();
}

// ══════════════════════════════════════════════
//  RENDER TABLE
// ══════════════════════════════════════════════
function render() {
  const q = document.getElementById("searchInp").value.toLowerCase();
  let data = allData.filter(d => {
    const mf = activeF === "all" || d.grade === activeF;
    const ms = !q || d.code.includes(q) || (d.name||"").toLowerCase().includes(q);
    return mf && ms;
  });

  data.sort((a,b)=>{
    const av = sortKey==="code" ? a.code : a[sortKey] ?? 0;
    const bv = sortKey==="code" ? b.code : b[sortKey] ?? 0;
    if (typeof av === "string") return sortAsc ? av.localeCompare(bv) : bv.localeCompare(av);
    return sortAsc ? av-bv : bv-av;
  });

  document.getElementById("tCount").textContent = `${data.length} سهم`;

  if (!data.length) {
    document.getElementById("tBody").innerHTML = `<tr><td colspan="9"><div class="empty">
      <div class="empty-ico">🔍</div>
      <div class="empty-ttl">لا توجد نتائج</div>
      <div class="empty-sub">جرب تغيير الفلتر أو كلمة البحث</div>
    </div></td></tr>`;
    return;
  }

  const rows = data.map((d,i) => {
    const gc   = d.grade==="A+"?"g-ap":d.grade==="A"?"g-a":d.grade==="B"?"g-b":"g-c";
    const gi   = d.grade==="A+"?"🟢":d.grade==="A"?"✅":d.grade==="B"?"🟡":"🔴";
    const extC = d.ext_pct > 5 ? "chg-neg" : d.ext_pct < -2 ? "chg-pos" : "chg-neu";
    const chgC = (d.chg||0) > 0 ? "chg-pos" : (d.chg||0) < 0 ? "chg-neg" : "chg-neu";
    const chgSign = (d.chg||0) >= 0 ? "+" : "";
    const vPct = Math.min((d.rel_vol/4)*100, 100);
    const vCol = d.rel_vol >= 2 ? "var(--green)" : d.rel_vol >= 1.5 ? "var(--gold)" : "var(--muted)";
    const trendTxt = d.trend==="up"?"📈 صاعد":d.trend==="down"?"📉 هابط":"➡️ محايد";
    const trendCol = d.trend==="up"?"var(--green)":d.trend==="down"?"var(--red)":"var(--muted)";
    return `<tr onclick="showMod('${d.code}')" style="animation:popIn .35s ${i*.04}s both">
      <td><div class="stock-code">${d.code}</div><div class="stock-nm">${d.name||""}</div></td>
      <td class="price-cell">${d.close.toFixed(2)} <span style="font-size:.65rem;color:var(--muted)">ر.س</span></td>
      <td class="${chgC}">${chgSign}${(d.chg||0).toFixed(2)}%</td>
      <td>
        <div class="sbar-wrap">
          <div class="sbar"><div class="sbar-fill" style="width:${d.score/50*100}%"></div></div>
          <div class="snum">${d.score}</div>
        </div>
      </td>
      <td><span class="badge ${gc}">${gi} ${d.grade}</span></td>
      <td class="${extC}">${d.ext_pct>0?"+":""}${d.ext_pct.toFixed(1)}%</td>
      <td>
        <div class="vol-wrap">
          <div class="vbar"><div class="vbar-fill" style="width:${vPct}%;background:${vCol}"></div></div>
          <span style="color:${vCol}">${d.rel_vol.toFixed(1)}x</span>
        </div>
      </td>
      <td style="color:var(--muted)">${d.atr_pct.toFixed(2)}%</td>
      <td style="color:${trendCol};font-size:.8rem;font-weight:700">${trendTxt}</td>
    </tr>`;
  }).join("");

  document.getElementById("tBody").innerHTML = rows;
}

// ══════════════════════════════════════════════
//  MODAL
// ══════════════════════════════════════════════
function showMod(code) {
  const d = allData.find(x=>x.code===code);
  if (!d) return;

  document.getElementById("mTitle").textContent = code;
  document.getElementById("mSub").textContent = (d.name||"") + " — " + (d.sector||"");

  const fmtMcap = v => v>=1e12?(v/1e12).toFixed(2)+"T ر.س":v>=1e9?(v/1e9).toFixed(1)+"B ر.س":(v/1e6).toFixed(0)+"M ر.س";
  const chgSign = (d.chg||0)>=0?"+":"";
  const extSign = d.ext_pct>=0?"+":"";

  // Mini bar chart (close vs SMA20 vs SMA50 vs Kelt)
  const vals  = [d.l1m, d.sma50, d.sma20, d.close, d.kelt, d.h1m].filter(Boolean);
  const vMin  = Math.min(...vals), vMax = Math.max(...vals);
  const norm  = v => Math.max(10, Math.round(((v-vMin)/(vMax-vMin||1))*48+4));
  const bars  = [
    {v:d.l1m,lbl:"أدنى شهري",active:false},
    {v:d.sma50,lbl:"SMA50",active:false},
    {v:d.sma20,lbl:"SMA20",active:false},
    {v:d.close,lbl:"السعر",active:true},
    {v:d.kelt,lbl:"كيلتنر",active:false},
    {v:d.h1m,lbl:"أعلى شهري",active:false},
  ].filter(b=>b.v>0);

  const barsHtml = bars.map(b=>`<div class="mc-bar${b.active?" active":""}" style="height:${norm(b.v)}px" title="${b.lbl}: ${b.v?.toFixed(2)}"></div>`).join("");

  document.getElementById("mBody").innerHTML = `
    <div class="mini-chart">
      <div class="mc-title">الموضع السعري (نطاق شهري)</div>
      <div class="mc-bars">${barsHtml}</div>
      <div style="display:flex;justify-content:space-between;font-size:.65rem;color:var(--muted);margin-top:.4rem">
        ${bars.map(b=>`<span>${b.lbl}</span>`).join("")}
      </div>
    </div>

    <div class="mgrid">
      <div class="mstat"><div class="ms-lbl">سعر الإغلاق</div>
        <div class="ms-val">${d.close.toFixed(2)} <span style="font-size:.65rem;color:var(--muted)">ر.س</span></div></div>
      <div class="mstat"><div class="ms-lbl">التغيير اليومي</div>
        <div class="ms-val" style="color:${(d.chg||0)>=0?'var(--green)':'var(--red)'}">${chgSign}${(d.chg||0).toFixed(2)}%</div></div>
      <div class="mstat"><div class="ms-lbl">النقاط الإجمالية</div>
        <div class="ms-val" style="color:var(--gold)">${d.score}<span style="font-size:.65rem;color:var(--muted)"> / 50</span></div></div>
      <div class="mstat"><div class="ms-lbl">الحجم النسبي 10د</div>
        <div class="ms-val" style="color:${d.rel_vol>=2?'var(--green)':d.rel_vol>=1.5?'var(--gold)':'var(--text)'}">${d.rel_vol.toFixed(2)}x</div></div>
      <div class="mstat"><div class="ms-lbl">SMA20 / SMA50</div>
        <div class="ms-val" style="font-size:.95rem">${d.sma20.toFixed(2)} / ${d.sma50.toFixed(2)}</div></div>
      <div class="mstat"><div class="ms-lbl">امتداد كيلتنر</div>
        <div class="ms-val" style="color:${d.ext_pct>5?'var(--red)':d.ext_pct<-2?'var(--green)':'var(--text)'}">${extSign}${d.ext_pct.toFixed(2)}%</div></div>
      <div class="mstat"><div class="ms-lbl">القيمة السوقية</div>
        <div class="ms-val" style="font-size:.9rem">${fmtMcap(d.mcap)}</div></div>
      <div class="mstat"><div class="ms-lbl">ATR%</div>
        <div class="ms-val" style="font-size:.9rem">${d.atr_pct.toFixed(2)}%</div></div>
    </div>

    <div style="margin-bottom:.9rem;font-size:.7rem;color:var(--gold);letter-spacing:.1em;font-weight:700;text-transform:uppercase">تحليل الشروط</div>
    <div class="clist">
      <div class="citem ${d.g1?'ok':'fail'}">
        <span class="cicon">${d.g1?'✅':'❌'}</span>
        <div class="ctxt">الاتجاه الصاعد (G1)
          <small>السعر > SMA20 > SMA50 — الامتداد ≤ 20%</small></div>
        <span class="cpts">${d.pts_g1??''}</span>
      </div>
      <div class="citem ${d.g3?'ok':'fail'}">
        <span class="cicon">${d.g3?'✅':'❌'}</span>
        <div class="ctxt">الحجم والسيولة (G3)
          <small>قيمة سوقية ≥ 50M | حجم نسبي ≥ 1.5x | Z-Score ≥ 2</small></div>
        <span class="cpts">${d.pts_g3??''}</span>
      </div>
      <div class="citem ${d.ext_pct<5?'ok':'fail'}">
        <span class="cicon">${d.ext_pct<5?'✅':'❌'}</span>
        <div class="ctxt">ضمن قناة كيلتنر
          <small>الامتداد عن الحد العلوي < 5% — حالياً: ${extSign}${d.ext_pct.toFixed(1)}%</small></div>
        <span class="cpts">${d.pts_kelt??''}</span>
      </div>
    </div>
    <div class="mdiscl">⚠️ هذه الأداة تعليمية بحتة. الأسعار المباشرة من TradingView ليست ضماناً لأداء مستقبلي. استشر مستشاراً مالياً معتمداً قبل أي قرار.</div>

    <div class="ai-chat-section">
      <div class="ai-chat-header">
        <div class="ai-chat-dot"></div>
        🤖 TITAN AI — اسأل عن هذا السهم
      </div>
      <div class="ai-suggestions-row" id="aiSugRow">
        <button class="ai-sug" onclick="aiQuickQ('هل هذا وقت مناسب للشراء؟')">هل أشتري الآن؟</button>
        <button class="ai-sug" onclick="aiQuickQ('ما المستوى المناسب لوقف الخسارة؟')">وقف الخسارة؟</button>
        <button class="ai-sug" onclick="aiQuickQ('ما أبرز مخاطر هذا السهم؟')">المخاطر؟</button>
        <button class="ai-sug" onclick="aiQuickQ('قيّم الوضع الفني لهذا السهم بشكل مختصر')">التحليل الفني</button>
      </div>
      <div class="ai-chat-messages" id="aiChatMsgs"></div>
      <div class="ai-chat-input-row">
        <input class="ai-chat-inp" id="aiChatInp"
               placeholder="اسأل TITAN AI عن هذا السهم..."
               onkeydown="if(event.key==='Enter')aiSend()">
        <button class="ai-send" id="aiSendBtn" onclick="aiSend()">
          <svg viewBox="0 0 24 24"><path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/></svg>
        </button>
      </div>
    </div>`;

  document.getElementById("mbg").classList.add("on");
  // ── تشغيل AI Chat لهذا السهم ──
  setTimeout(() => aiSetStock(d), 120);
}

function closeMod(e) {
  if (e.target === document.getElementById("mbg"))
    document.getElementById("mbg").classList.remove("on");
}

// ══════════════════════════════════════════════
//  TOAST
// ══════════════════════════════════════════════
let toastTimer;
function showToast(msg, type="ok") {
  const t = document.getElementById("toast");
  clearTimeout(toastTimer);
  t.textContent = msg;
  t.className = `toast ${type}`;
  t.style.display = "block";
  toastTimer = setTimeout(() => { t.style.display = "none"; }, 3200);
}

// ESC to close modal
document.addEventListener("keydown", e => {
  if (e.key==="Escape") document.getElementById("mbg").classList.remove("on");
});

// ══════════════════════════════════════════════
//  TITAN AI CHAT — داخل الـ Modal
// ══════════════════════════════════════════════
let aiCurrentStock = null;
let aiHistory      = [];
let aiLoading      = false;

function aiResetChat() {
  aiHistory = [];
  const msgs = document.getElementById("aiChatMsgs");
  if (msgs) msgs.innerHTML = "";
  const inp = document.getElementById("aiChatInp");
  if (inp) inp.value = "";
  document.getElementById("aiSendBtn").disabled = false;
}

// يُستدعى من showMod لتحديث السهم الحالي
function aiSetStock(d) {
  aiCurrentStock = d;
  aiResetChat();
  // رسالة ترحيب تلقائية
  const gradeLabel = d.grade==="A+"?"ممتاز 🟢":d.grade==="A"?"جيد جداً ✅":d.grade==="B"?"متوسط 🟡":"ضعيف 🔴";
  aiAddMsg("ai",
    `مرحباً! أنا جاهز لتحليل **${d.name||d.code}** (${d.code}).\n` +
    `السعر الحالي: **${d.close.toFixed(2)} ر.س** | التصنيف: **${gradeLabel}** | النقاط: **${d.score}/50**\n` +
    `اسألني أي سؤال عن هذا السهم 👇`
  );
}

function aiAddMsg(role, text) {
  const msgs = document.getElementById("aiChatMsgs");
  if (!msgs) return;
  const div = document.createElement("div");
  div.className = `acm ${role}`;
  const av = role==="ai"
    ? `<div class="acm-av">AI</div>`
    : `<div class="acm-av">👤</div>`;
  div.innerHTML = `${av}<div class="acm-bbl">${formatAiText(text)}</div>`;
  msgs.appendChild(div);
  msgs.scrollTop = msgs.scrollHeight;
}

function formatAiText(t) {
  t = t.replace(/\*\*(.*?)\*\*/g, "<strong>$1</strong>");
  t = t.replace(/🟢([^\n<]+)/g, '<span class="tg">🟢$1</span>');
  t = t.replace(/🔴([^\n<]+)/g, '<span class="tr">🔴$1</span>');
  t = t.replace(/\n/g, "<br>");
  return t;
}

function aiShowTyping() {
  const msgs = document.getElementById("aiChatMsgs");
  if (!msgs) return;
  const div = document.createElement("div");
  div.className = "acm ai"; div.id = "aiTyping";
  div.innerHTML = `<div class="acm-av">AI</div>
    <div class="ai-typing"><span></span><span></span><span></span></div>`;
  msgs.appendChild(div);
  msgs.scrollTop = msgs.scrollHeight;
}

function aiHideTyping() {
  const el = document.getElementById("aiTyping");
  if (el) el.remove();
}

function aiQuickQ(q) {
  document.getElementById("aiChatInp").value = q;
  aiSend();
}

async function aiSend() {
  if (aiLoading || !aiCurrentStock) return;
  const inp = document.getElementById("aiChatInp");
  const q   = inp.value.trim();
  if (!q) return;

  inp.value = "";
  aiLoading = true;
  document.getElementById("aiSendBtn").disabled = true;
  // إخفاء الاقتراحات بعد أول سؤال
  const sugRow = document.getElementById("aiSugRow");
  if (sugRow) sugRow.style.display = "none";

  aiAddMsg("user", q);
  aiHistory.push({ role:"user", content: q });
  aiShowTyping();

  const d = aiCurrentStock;
  const systemPrompt = `أنت TITAN AI — محلل السوق السعودي المتخصص. تتحدث العربية فقط.

بيانات السهم الحالي:
- الرمز: ${d.code} | الاسم: ${d.name||d.code} | القطاع: ${d.sector||"—"}
- السعر: ${d.close.toFixed(2)} ر.س | التغيير: ${(d.chg||0)>0?"+":""}${(d.chg||0).toFixed(2)}%
- SMA20: ${d.sma20.toFixed(2)} | SMA50: ${d.sma50.toFixed(2)}
- الحجم النسبي: ${d.rel_vol.toFixed(2)}x | ATR%: ${d.atr_pct.toFixed(2)}%
- امتداد كيلتنر: ${d.ext_pct>0?"+":""}${d.ext_pct.toFixed(2)}%
- شرط G1 (اتجاه صاعد): ${d.g1?"✅ محقق":"❌ غير محقق"}
- شرط G3 (حجم وسيولة): ${d.g3?"✅ محقق":"❌ غير محقق"}
- التصنيف: ${d.grade} | النقاط: ${d.score}/50
- الاتجاه: ${d.trend==="up"?"📈 صاعد":d.trend==="down"?"📉 هابط":"➡️ محايد"}
- القيمة السوقية: ${d.mcap>=1e12?(d.mcap/1e12).toFixed(2)+"T":d.mcap>=1e9?(d.mcap/1e9).toFixed(1)+"B":"—"} ر.س

قواعد الإجابة:
1. أجب بالعربية فقط، موجز ومفيد (3-5 جمل)
2. استخدم البيانات أعلاه مباشرة في إجابتك
3. استخدم 📈🟢🔴 لتوضيح الاتجاهات
4. أضف دائماً: "⚠️ تحليل تعليمي فقط"`;

  try {
    const res = await fetch("https://api.anthropic.com/v1/messages", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        model: "claude-sonnet-4-20250514",
        max_tokens: 1000,
        system: systemPrompt,
        messages: aiHistory
      })
    });
    const data = await res.json();
    aiHideTyping();
    const reply = data?.content?.[0]?.text || "عذراً، لم أتمكن من المعالجة.";
    aiAddMsg("ai", reply);
    aiHistory.push({ role:"assistant", content: reply });
    if (aiHistory.length > 12) aiHistory = aiHistory.slice(-10);
  } catch(e) {
    aiHideTyping();
    aiAddMsg("ai", "⚠️ تعذّر الاتصال بـ TITAN AI. تأكد من الاتصال بالإنترنت.");
  } finally {
    aiLoading = false;
    document.getElementById("aiSendBtn").disabled = false;
    document.getElementById("aiChatInp").focus();
  }
}
</script>
<script>
if('serviceWorker' in navigator){
  const swBlob = new Blob([`const CACHE='titan-v1';
self.addEventListener('install',e=>{self.skipWaiting();});
self.addEventListener('activate',e=>{self.clients.claim();});
self.addEventListener('fetch',e=>{e.respondWith(fetch(e.request).catch(()=>caches.match(e.request)));});`],{type:'text/javascript'});
  const swUrl  = URL.createObjectURL(swBlob);
  navigator.serviceWorker.register(swUrl);
}
</script>
</body>
</html>
